GITHUB_REPO="simtxng/transmitter-go"
LINUX_WORKFLOW="build-linux.yml"
WINDOWS_WORKFLOW="build-windows.yml"
MACOS_WORKFLOW="build-macos.yml"
HOST="127.0.0.1"
PORT="8000"
CACHE_DIR="./cache"
LATEST_TTL="60"
TAG_TTL="3000"
TARGETS_TTL="300"
PREFETCH="1"
REFRESH_INTERVAL="300"
CACHE_MAX_RUNS="10"
VERSION_RETURN="0.1.0-alpha-5"
# Unset/comment VERSION_RETURN to serve the latest git tag instead
# (one leading v/V stripped, cached TAG_TTL seconds).
# Armored private repo-signing key file (chmod 600, never commit).
# Absent = repo metadata routes answer 503, packages still serve.
SIGNING_KEY_FILE="./signing.key"
# Separate RSA private key for the XBPS/Void repo (PKCS#1 or PKCS#8 PEM,
# chmod 600, never commit). Absent = /xbps repo routes answer 503.
XBPS_SIGNING_KEY_FILE="./xbps-signing.key"
XBPS_SIGNED_BY="SimTX XBPS Repository <packages@simtx.net>"
# Optional passphrase for an encrypted XBPS RSA key.
# XBPS_PASSPHRASE=""

GITHUB_TOKEN="asd"
# Bearer token guarding PUT/DELETE /upload/... . Unset/empty = uploads disabled (503).
UPLOAD_TOKEN="change-me-long-random"
# Max single upload size in megabytes.
UPLOAD_MAX_MB="500"
